{
  "name": "sgk/barcode-bundle",
  "type": "symfony-bundle",
  "description": "Symfony2 Barcode Generator Bundle with Twig function extension",
  "keywords": [
    "Symfony2",
    "barcode",
    "Symfony",
    "Bundle",
    "Twig",
    "generator",
    "qrcode",
    "qr code"
  ],
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "SGK\\BarcodeBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SGK\\BarcodeBundle\\Tests\\": "Tests/"
    }
  },
  "authors": [
    {
      "name": "Dinesh Rabara",
      "email": "dinesh.rabara@gmail.com"
    },
    {
      "name": "SHANG Guokan",
      "email": "shangguokan@hotmail.com",
      "homepage": "https://github.com/shangguokan"
    }
  ],
  "require": {
    "php": "^8.4",
    "symfony/config": "^7.4 || ^8.0",
    "symfony/dependency-injection": "^7.4 || ^8.0",
    "symfony/http-kernel": "^7.4 || ^8.0",
    "symfony/options-resolver": "^7.4 || ^8.0",
    "twig/twig": "^3.0"
  },
  "suggest": {
    "symfony/twig-bundle": "^7.4 || ^8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0"
  },
  "minimum-stability": "stable",
  "scripts": {
    "test": "phpunit"
  }
}
